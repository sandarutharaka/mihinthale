{
  "name": "mihintale-3d-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:prepare": "node --experimental-strip-types scripts/prepare-data.ts",
    "test:e2e": "playwright test",
    "data:landmarks": "node scripts/verify-landmarks.ts && node scripts/export-references.ts",
    "models:build": "node scripts/create-landmark-assets.mjs",
    "references:index": "node scripts/index-references.mjs && node --experimental-strip-types scripts/export-site-plan.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.180.0",
    "@fontsource/noto-sans-sinhala": "5.2.5"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "@types/node": "22.15.30",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "@vitejs/plugin-react": "5.0.4",
    "geotiff": "3.0.5",
    "osmtogeojson": "3.0.0-beta.5",
    "@playwright/test": "1.56.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}
